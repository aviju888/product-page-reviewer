{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "start": "npm run api",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
